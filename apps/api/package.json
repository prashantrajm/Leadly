{
  "name": "api",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "prisma:dev": "bunx prisma generate --watch",
    "db:push": "bunx prisma db push",
    "migrate:dev": "bunx prisma migrate dev",
    "migrate": "bunx prisma migrate deploy",
    "reset": "bunx prisma migrate reset --force",
    "generate": "bunx prisma generate",
    "studio": "bunx prisma studio",
    "db:seed": "bun prisma/seed.ts"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@hono/zod-openapi": "^1.2.0",
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "latest",
    "@prisma/client-runtime-utils": "^7.2.0",
    "better-auth": "1.3.13",
    "pg": "^8.13.1",
    "hono": "^4.11.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@prisma/config": "latest",
    "@types/bun": "latest",
    "@types/pg": "^8.11.10",
    "prisma": "latest"
  }
}
