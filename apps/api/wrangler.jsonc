{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leadly-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-24",
  "env": {
    "development": {
      // "vars": {} // Do NOT use empty vars block as it clears dashboard variables on deploy
    }
  },
  "dev": {
    "port": 8787
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://api.example.com",
    "CORS_ORIGIN": "https://example.com"
  },
  // [Note] Sensitive data below MUST be set as secrets using:
  // `npx wrangler secret put BETTER_AUTH_SECRET`
  // `npx wrangler secret put GOOGLE_CLIENT_SECRET`
  // `npx wrangler secret put DATABASE_URL`
  // `npx wrangler secret put GOOGLE_CLIENT_ID` (already exists as secret)
  // `npx wrangler secret put OPENROUTER_API_KEY`
  // `npx wrangler secret put SECRETS_ENCRYPTION_KEY`  (openssl rand -base64 32)
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // KV: widget config cache (60s TTL) + per-visitor rate-limit counters.
  // The `id` is the production namespace from `wrangler kv namespace create`;
  // wrangler dev uses an in-memory miniflare emulation so dev needs no real id.
  "kv_namespaces": [
    {
      "binding": "WIDGET_CACHE",
      "id": "leadly-widget-cache"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "your-app-media"
    }
  ],
  // KB re-embedding pipeline. KbReembedWorkflow is exported from src/index.ts;
  // env.KB_REEMBED.create({ params: { articleId } }) kicks off a durable run.
  "workflows": [
    {
      "name": "kb-reembed",
      "binding": "KB_REEMBED",
      "class_name": "KbReembedWorkflow"
    },
    {
      "name": "conversation-summarize",
      "binding": "CONVERSATION_SUMMARIZE",
      "class_name": "ConversationSummarizeWorkflow"
    }
  ],
  // Durable Object: one instance per conversationId. The DO holds the live
  // WebSocket(s), runs the agent loop, persists turns. Hibernation keeps
  // idle conversations free per design §5.3.
  "durable_objects": {
    "bindings": [
      {
        "name": "CONVERSATION",
        "class_name": "ConversationDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-conversation-do",
      "new_sqlite_classes": ["ConversationDO"]
    }
  ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },

}